# 파이 4 (8GB) 권장 추가 설정. 기존 .env 에 이어 붙인다. (비밀값 없음)
GEN_MODEL=gemma3:1b
EMBED_MODEL=bge-m3
OLLAMA_HOST=http://127.0.0.1:11434
NUM_CTX=3072                 # 4096 → 줄이면 파이에서 빨라진다
GEN_NUM_PREDICT=300
LLM_TIMEOUT_SEC=300          # 파이 CPU는 느리므로 넉넉히
REFRESH_INTERVAL_MIN=60
# SD 카드 수명을 위해 데이터는 SSD(/srv/nas)에 둔다
BOT_DATA_DIR=/srv/nas/ailab-bot/data
