# 변수 이름만 적은 예시입니다. 실제 값은 .env에 넣고 절대 커밋하지 않습니다.
# 시작할 때 [필수] 변수가 비어 있으면 봇은 변수 "이름"만 출력하고 종료합니다(값은 출력하지 않음).

# ===== [필수] 슬랙 =====
SLACK_BOT_TOKEN=            # xoxb-...  (Bot User OAuth Token)
SLACK_APP_TOKEN=            # xapp-...  (Socket Mode 앱 수준 토큰, connections:write)

# ===== [필수] LangSmith 추적 =====
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ailab-slack-bot

# ===== [필수] 모델 (Ollama) =====
GEN_MODEL=gemma3:1b         # 개발: gemma3:1b / 최종: gemma3:4b
EMBED_MODEL=bge-m3
OLLAMA_HOST=http://localhost:11434

# ===== [필수] 구글 시트 CSV 내보내기 URL (이 URL을 아는 사람은 시트를 읽을 수 있으므로 토큰처럼 취급) =====
SHEET_CSV_CONTEST=
SHEET_CSV_NEWS_INAI=
SHEET_CSV_NEWS_AITIMES=
SHEET_CSV_CODING_PROGRAMMERS=
SHEET_CSV_CODING_SWEA=

# ===== [필수] SWEA 문제 읽기 전용 계정 (실제로 쓰지 않는 전용 계정만) =====
SWEA_ID=
SWEA_PW=

# ===== [권장] 사용자 ID 해시용 솔트. 임의의 긴 문자열로 정하세요(로그·LangSmith에 남는 해시의 역추적 방지) =====
USER_HASH_SALT=

# ===== [선택] 수상작 분석(웹 검색). 키가 없으면 해당 질문에 "웹 검색을 쓸 수 없어…"로 답합니다 =====
SEARCH_PROVIDER=naver       # naver | searxng
NAVER_CLIENT_ID=            # SEARCH_PROVIDER=naver 일 때
NAVER_CLIENT_SECRET=
SEARXNG_URL=                # SEARCH_PROVIDER=searxng 일 때. 예: http://localhost:8080

# ===== [선택] 동작 옵션 =====
# SANDBOX=docker              # docker(기본, 코드 실행 격리) | local(Docker를 쓸 수 없을 때만, 1차 방어)
# ENRICH_UNKNOWN_DEADLINE=true  # 마감일이 빈 최근 공고의 상세 페이지를 읽어 마감일을 채움(기본 true)

# ===== [선택] 테스트 채널 =====
# 보통은 이 변수들을 켜지 말고 `python app.py --test`, `python index.py --test` 로 실행하세요.
# (--test 는 채널을 TEST_CHANNEL_NAME 으로, 데이터 폴더를 data-test 로 바꿉니다. 아래를 .env에서 켜 두면 운영 실행도 테스트 채널을 보게 되므로 주석으로 둡니다.)
TEST_CHANNEL_NAME=봇-테스트       # --test 와 scripts/seed_test_channel.py 가 쓰는 테스트 채널 이름
# CHANNEL_NAME_ALL=봇-테스트        # (고급) --test 없이 직접 지정할 때: 세 채널을 모두 이 채널로
# CHANNEL_NAME_CONTEST=             # 채널별로 따로 지정할 때
# CHANNEL_NAME_NEWS=
# CHANNEL_NAME_CODING=
# BOT_DATA_DIR=data-test
